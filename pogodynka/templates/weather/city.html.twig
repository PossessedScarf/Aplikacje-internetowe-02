{% extends 'base.html.twig' %}

{# @var location \App\Entity\Location #}
{# @var weather \App\Entity\Weather #}

{% block title %}Weather in {{ location.city }}, {{ location.country }}{% endblock %}

{% block body %}
    <main>
        <h1>Weather in: {{ location.city }}, {{ location.country }}</h1>
        <ul>
            {% for maesurement in measurements %}
                <li>{{ maesurement.date|date('d.m.y')
                    }}: {{ maesurement.celsius
                    }}&deg;C feels like: {{ maesurement.getFeelsLike()
                    }}&deg;C {{ maesurement.description ?? 'Clear sky' }}</li>
            {% endfor %}
        </ul>
    </main>
{% endblock %}

